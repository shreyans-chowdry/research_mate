# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/researchmate

# LLM Providers (At least GOOGLE_API_KEY is recommended)
GOOGLE_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

# Academic Search (Optional — European PMC, ArXiv, OpenAlex work without keys, but adding your email enables polite pool)
OPENALEX_EMAIL=your_email@domain.com
SEMANTIC_SCHOLAR_API_KEY=

# Production Deployment Configuration
PORT=8000
FRONTEND_URL=https://your-frontend-app.vercel.app
